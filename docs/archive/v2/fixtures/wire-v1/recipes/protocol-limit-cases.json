{
  "version": 1,
  "source": "ProtocolWelcome.data.limits",
  "probeContract": {
    "operation": "invoke_named_owner_validator_with_measured_metric",
    "context": "minimal_valid_non_target_fields",
    "payloadGeneration": "not_implied; integration payloads live in boundary-cases.json and public manifest vectors",
    "assertion": "boundary passes this validator; boundaryPlusOne fails this validator"
  },
  "forEachLeaf": {
    "boundary": "accepted_by_owning_limit_validator",
    "boundaryPlusOne": "rejected_by_owning_limit_validator",
    "note": "A full DTO may be constrained by a narrower nested limit; the owner-level probe isolates the advertised leaf before integration vectors compose limits."
  },
  "validatorSelectors": [
    {"paths":["transport.maxRequestBytes","transport.maxResponseBytes","transport.maxRuntimeSnapshotBytes","transport.maxSessionSnapshotBytes","transport.maxStateEventBytes","transport.maxProgressEventBytes"],"validator":"encoded_frame_preflight"},
    {"paths":["transport.maxJsonDepth","transport.maxObjectMembers","transport.maxArrayItems","transport.maxStringBytes"],"validator":"public_json_structural_decoder"},
    {"pathPrefix":"text.","validator":"owning_safe_text_constructor"},
    {"pathPrefix":"catalog.","validator":"command_catalog_constructor"},
    {"paths":["paging.maxPageSize"],"validator":"page_request_validator"},
    {"paths":["paging.maxPageCursorBytes"],"validator":"cursor_allocation_preflight"},
    {"pathPrefix":"prompt.","validator":"prompt_intent_or_message_constructor"},
    {"pathPrefix":"workspace.","validator":"workspace_lexical_constructor"},
    {"pathPrefix":"queues.","validator":"queue_collection_constructor"},
    {"pathPrefix":"interaction.","validator":"interaction_constructor"},
    {"pathPrefix":"observation.","validator":"observation_view_or_snapshot_preflight"},
    {"pathPrefix":"embeddedJson.value.","validator":"bounded_json_value_constructor"},
    {"pathPrefix":"embeddedJson.schema.","validator":"bounded_json_schema_constructor"}
  ],
  "specialCases": {
    "paging.maxPageCursorBytes": {"target":"PageCursor input allocation buffer","canonicalV1CarrierBytes":47,"boundaryResult":"passes_allocation_preflight_then_fails_typed_cursor_unless_exact_47","plusOneResult":"fails_allocation_preflight"},
    "text.maxDiagnosticMessageBytes": {"target":"public RuntimeDiagnosticView/SessionDiagnosticView.message","replayDetailBytes":512,"note":"replay detail cap is storage-internal and not this advertised public leaf"},
    "embeddedJson.value.maxEncodedBytes": {"validator":"raw_and_canonical_output_byte_gates","integrationCases":["bounded_json_input_bytes_boundary","bounded_json_input_bytes_oversized","bounded_json_output_bytes_boundary","bounded_json_output_bytes_oversized"]},
    "embeddedJson.schema.maxEncodedBytes": {"validator":"raw_and_canonical_output_byte_gates","integrationCases":["bounded_schema_input_bytes_boundary","bounded_schema_input_bytes_oversized","bounded_schema_output_bytes_boundary","bounded_schema_output_bytes_oversized"]}
  },
  "limits": {
    "transport": {"maxRequestBytes":1048576,"maxResponseBytes":8388608,"maxRuntimeSnapshotBytes":8388608,"maxSessionSnapshotBytes":8388608,"maxStateEventBytes":8388608,"maxProgressEventBytes":65536,"maxJsonDepth":64,"maxObjectMembers":256,"maxArrayItems":4096,"maxStringBytes":262144},
    "text": {"maxTextIntentBytes":131072,"maxCommandInputBytes":32768,"maxCommandOutputBytes":65536,"maxDisplayNameBytes":256,"maxDescriptionBytes":8192,"maxPublicSummaryBytes":8192,"maxDiagnosticCodeBytes":64,"maxDiagnosticMessageBytes":2048},
    "catalog": {"maxCommandPathSegments":16,"maxCommandArguments":64,"maxCommandCatalogEntries":1024},
    "paging": {"maxPageSize":200,"maxPageCursorBytes":256},
    "prompt": {"maxSkillsPerIntent":32,"maxUserMessageParts":64,"maxMessagePartBytes":131072,"maxUserMessageBytes":524288},
    "workspace": {"maxWorkspaceRoots":16,"maxAbsolutePathUriBytes":8192,"maxRelativePathBytes":4096,"maxRelativePathSegments":256},
    "queues": {"maxSubmitAdmissions":16,"maxSteers":32,"maxFollowUps":32},
    "interaction": {"maxToolApprovalOptions":16,"maxInteractionQuestions":32,"maxChoicesPerQuestion":64,"maxAnswerTextBytes":16384,"maxInteractionAnswerBytes":65536,"maxInteractionViewBytes":131072},
    "observation": {"maxActiveItems":64,"maxItemViewBytes":65536,"maxPendingInteractions":16,"maxSnapshotDiagnostics":50,"maxQueryDiagnosticsPerScope":100},
    "embeddedJson": {
      "value": {"maxEncodedBytes":65536,"maxDepth":32,"maxArrayItems":256,"maxObjectMembers":256,"maxStringBytes":16384,"maxNumberLiteralBytes":64},
      "schema": {"maxEncodedBytes":65536,"maxDepth":32,"maxNodes":4096,"maxPropertiesRequiredOrEnumItems":256,"maxRegexBytes":1024}
    }
  }
}
