{
  "version": 1,
  "lineEndingBytesExcludedFromLineCaps": true,
  "cases": [
    {
      "name": "header_line_boundary",
      "scope": "conversation_header_line",
      "targetBytesExcludingLineEnding": 65536,
      "generator": {
        "kind": "headerWithTrailingWhitespace",
        "lineEnding": "lf"
      },
      "expected": {
        "load": "succeeds"
      }
    },
    {
      "name": "header_line_oversized",
      "scope": "conversation_header_line",
      "targetBytesExcludingLineEnding": 65537,
      "generator": {
        "kind": "headerWithTrailingWhitespace",
        "lineEnding": "lf"
      },
      "expected": {
        "load": "fails",
        "error": "HeaderCorrupt",
        "truncate": false
      }
    },
    {
      "name": "entry_line_boundary",
      "scope": "conversation_entry_line",
      "targetBytesExcludingLineEnding": 1048576,
      "generator": {
        "kind": "entryWithBoundedUnknownPadding",
        "lineEnding": "lf"
      },
      "expected": {
        "lineAccepted": true
      }
    },
    {
      "name": "entry_line_oversized",
      "scope": "conversation_entry_line",
      "targetBytesExcludingLineEnding": 1048577,
      "generator": {
        "kind": "entryWithBoundedUnknownPaddingThenCanonicalEntry",
        "lineEnding": "lf"
      },
      "expected": {
        "lineAccepted": false,
        "diagnostic": "oversized_line",
        "scanContinuesAfterLf": true,
        "followingCanonicalEntryAccepted": true
      }
    },
